{
  "manifest_version": 3,
  "name": "WA Group Scraper",
  "version": "1.0",
  "description": "Scrape WhatsApp group members and export to XLSX",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WA Group Scraper",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xlsx.full.min.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
